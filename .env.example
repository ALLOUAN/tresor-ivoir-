APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# ── Modules IA (valeurs par défaut sûres ; tout est facultatif) ──
# AI_ENABLED=true
# AI_TRACKING=true
# AI_ANALYTICS_COLLECT=true
# AI_MODERATION_AUTO=true

# ── Production : à vérifier sur le serveur ──
# APP_ENV=production
# APP_DEBUG=false
# SESSION_SECURE_COOKIE=true
# MAIL_SCHEME=smtps        (port 465)  |  MAIL_SCHEME=null + MAIL_ENCRYPTION=tls (port 587)
# Clés Google : deux clés distinctes, restreintes (navigateur : Maps JavaScript + Places (New) + domaine ;
#                serveur : Routes API + IP du serveur). Ne jamais téléverser le .env ni bootstrap/cache/.

# Versements automatiques aux prestataires (API de transfert CinetPay) — laisser à false tant que
# le service de transfert n'est pas activé sur le compte marchand.
CINETPAY_TRANSFER_ENABLED=false
CINETPAY_TRANSFER_API_KEY=
CINETPAY_TRANSFER_PASSWORD=
CINETPAY_TRANSFER_MAX_AUTO_XOF=500000

# Double authentification des administrateurs (code par e-mail). Vérifier l'envoi d'e-mails avant d'activer.
ADMIN_2FA_ENABLED=false

# Sauvegarde hors serveur (SFTP vers un autre hébergeur / espace de stockage). Vide = sauvegarde locale seule.
BACKUP_SFTP_HOST=
BACKUP_SFTP_PORT=22
BACKUP_SFTP_USERNAME=
BACKUP_SFTP_PASSWORD=
BACKUP_SFTP_ROOT=/backups/tresorsivoire

# SMS / WhatsApp sur les événements clés (off | log | twilio). Canal : sms | whatsapp.
TEXT_MESSAGES_DRIVER=off
TEXT_MESSAGES_CHANNEL=sms
TEXT_MESSAGES_FROM=
TWILIO_SID=
TWILIO_TOKEN=

# Assistant ancré sur Google Maps (Gemini). Relais quand le site ne connaît pas la réponse.
AI_MAPS_GROUNDING=false
GEMINI_API_KEY=
AI_MAPS_MODEL=gemini-2.5-flash
