<IfModule mod_rewrite.c>
<IfModule mod_negotiation.c>
Options -MultiViews +FollowSymLinks
</IfModule>

RewriteEngine On

# Transmettre l'en-tête Authorization à PHP
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Contournement : /storage/* servi directement depuis son vrai chemin
# (le lien symbolique public/storage ne fonctionne pas sur cet hébergement)
RewriteCond %{REQUEST_URI} ^/storage/
RewriteCond %{REQUEST_URI} !^/storage/app/public/
RewriteRule ^storage/(.*)$ storage/app/public/$1 [L]


# Si le fichier/dossier demandé existe physiquement dans public/, le servir tel quel
RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f [OR]
RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -d
RewriteRule ^(.*)$ public/$1 [L]

# Sinon, tout le reste passe par le front controller Laravel
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ server.php [L]
</IfModule>

# ── Performance : compression et cache navigateur (sans effet si les modules sont absents) ──
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/xhtml+xml
    AddOutputFilterByType DEFLATE application/javascript text/javascript application/json application/ld+json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
</IfModule>
